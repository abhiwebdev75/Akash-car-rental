# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (customer + admin apps)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# ─── Database (MongoDB Atlas) ─────────────────────────────
# Atlas SRV connection string. The database name goes in the path.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/car_rental?retryWrites=true&w=majority
# Separate DB for automated tests (optional; tests use in-memory Mongo by default)
MONGODB_URI_TEST=

# ─── Auth / JWT ───────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ─── Cloudinary (media & documents) ───────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder prefix for uploaded assets
CLOUDINARY_FOLDER=car-rental

# ─── Business / bootstrap ─────────────────────────────────
# Used by the seed script to create the first OWNER account.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=Owner@12345
OWNER_NAME=Business Owner

# ─── Uploads / limits ─────────────────────────────────────
MAX_UPLOAD_MB=8

# ─── Rate limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
