# Frontend environment variables (Vite exposes only VITE_-prefixed vars to the app).
# Copy this file to `.env` and adjust as needed.

# Base URL the app uses for API calls. In development, leave this as the relative
# path `/api` and let the Vite dev-server proxy (below) forward it to the backend.
# In production, point it at your deployed API origin, e.g. https://api.example.com/api
VITE_API_BASE_URL=/api

# Dev-only: where the Vite proxy forwards `/api` requests. Match your backend PORT.
VITE_API_PROXY=http://localhost:5000
